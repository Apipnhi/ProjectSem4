# =============================================================================
# PENGATURAN VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# =============================================================================
# 1. Salin file ini: cp .env.example .env.local
# 2. Dapatkan API key Groq dari: https://console.groq.com/
# 3. Ganti nilai placeholder di bawah dengan key asli Anda
# 4. Jangan pernah commit .env.local ke Git!
# =============================================================================

# Konfigurasi Groq API
# Dapatkan API key dari Groq Console (https://console.groq.com/)
# Digunakan untuk generasi pack bertenaga AI dan prediksi penjualan
GROQ_API_KEY=masukkan_groq_api_key_anda_disini

# Alternatif: Gunakan key terpisah untuk fitur berbeda
# GROQ_API_KEY_PACKS=groq_api_key_untuk_packs_disini
# GROQ_API_KEY_PREDICTIONS=groq_api_key_untuk_prediksi_disini

# =============================================================================
# INSTRUKSI SETUP:
# 1. Buat akun di https://console.groq.com/
# 2. Masuk ke bagian API Keys
# 3. Klik "Create API Key"
# 4. Salin key tersebut dan tempel di atas
# 5. Simpan file ini sebagai .env.local
# =============================================================================

# ENGLISH VERSION

# =============================================================================
# ENVIRONMENT VARIABLES SETUP
# =============================================================================
# 1. Copy this file: cp .env.example .env.local
# 2. Get your Groq API key from: https://console.groq.com/
# 3. Replace the placeholder values below with your actual keys
# 4. Never commit .env.local to Git!
# =============================================================================

# Groq API Configuration
# Get your API key from Groq Console (https://console.groq.com/)
# Used for AI-powered pack generation and sales predictions
GROQ_API_KEY=your_groq_api_key_here

# Alternative: Use separate keys for different features
# GROQ_API_KEY_PACKS=your_groq_api_key_for_packs_here
# GROQ_API_KEY_PREDICTIONS=your_groq_api_key_for_predictions_here

# =============================================================================
# SETUP INSTRUCTIONS:
# 1. Create account at https://console.groq.com/
# 2. Navigate to API Keys section
# 3. Click "Create API Key"
# 4. Copy the key and paste it above
# 5. Save this file as .env.local
# =============================================================================